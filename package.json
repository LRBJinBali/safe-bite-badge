{
  "name": "safe-bite-badge",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "wrangler dev",
    "deploy": "nuxt build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply safe-bite --local",
    "db:migrate:remote": "wrangler d1 migrations apply safe-bite --remote",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@vueuse/nuxt": "^15.0.0",
    "mapbox-gl": "^3.33.0",
    "nuxt": "^4.6.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@iconify-json/lucide": "^1.2.147",
    "@nuxt/eslint": "^1.17.0",
    "@types/mapbox-gl": "^3.5.0",
    "eslint": "^10.13.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  }
}
